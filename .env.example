# ==========================================================
# SOLCARE / GROWATT - VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha os valores reais.
# Nunca envie o arquivo .env para o GitHub.
# ==========================================================

# --------------------------
# Growatt OpenAPI
# --------------------------
GROWATT_API_TOKEN=
GROWATT_SERVER_URL=https://openapi.growatt.com/v1/

# Opcionais para os relatórios atuais; o monitor de falhas exige ambos.
GROWATT_PLANT_ID=
GROWATT_DEVICE_SN=

# --------------------------
# Inteligência Artificial - Groq
# --------------------------
AI_ENABLED=false
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=12
GROQ_MAX_COMPLETION_TOKENS=600

# --------------------------
# Growatt Fault Log
# --------------------------
# Credenciais da conta ShinePhone/ShineServer usadas apenas para ler
# o histórico oficial de falhas. Nunca salve valores reais neste arquivo.
GROWATT_USERNAME=
GROWATT_PASSWORD=
GROWATT_WEB_SERVER=https://openapi.growatt.com

# Eventos mais antigos que este limite são importados sem notificação.
FAULT_NOTIFY_MAX_AGE_MINUTES=120

# Para confirmar recuperação via OpenAPI V4, a telemetria precisa ser recente.
FAULT_LIVE_MAX_AGE_MINUTES=30

# Quantas leituras normais consecutivas confirmam a recuperação.
FAULT_RECOVERY_CONFIRMATIONS=2

# --------------------------
# Supabase / PostgreSQL
# --------------------------
DATABASE_URL=

# --------------------------
# WhatsApp - destinatário principal (GREEN-API)
# --------------------------
GREEN_API_URL=https://api.green-api.com
GREEN_API_ID=
GREEN_API_TOKEN=
GREEN_API_CHAT_ID=

# Bot conversacional via webhook.
# AUTHORIZED_CHAT_ID deve ser o chatId exato recebido da GREEN-API,
# normalmente no formato 55...@c.us para conversa individual.
AUTHORIZED_CHAT_ID=

# Opcional: destino usado para responder ao cliente.
# Configure com o chatId canônico retornado pelo CheckWhatsapp, por exemplo
# um identificador @lid, quando a GREEN-API restringir o envio pelo @c.us.
# Se ficar vazio, o bot responde para o próprio AUTHORIZED_CHAT_ID recebido.
GREEN_API_REPLY_CHAT_ID=

# Token secreto usado somente para autenticar chamadas ao webhook público.
# No painel da GREEN-API configure Webhook URL Token como:
# Bearer <mesmo-valor-configurado-abaixo>
GREEN_API_WEBHOOK_TOKEN=

# Segundo destinatário (CallMeBot, opcional)
WHATSAPP_PHONE_2=
WHATSAPP_APIKEY_2=

# --------------------------
# Localização da usina
# --------------------------
STATION_LATITUDE=-14.2732856
STATION_LONGITUDE=-42.2586032

# --------------------------
# Relatório mensal e economia
# --------------------------
ENERGY_TARIFF=
AVERAGE_CONSUMPTION_KWH=
TUSD_FIO_B_KWH=
FIO_B_PERCENTAGE=

# Opcional para gerar um mês específico no formato YYYY-MM
REPORT_YEAR_MONTH=

# --------------------------
# Análise preventiva de manutenção
# Os valores abaixo são opcionais; estes são os padrões sugeridos.
# --------------------------
MAINTENANCE_HISTORY_DAYS=45
MAINTENANCE_RECENT_DAYS=4
MAINTENANCE_BASELINE_DAYS=7
MAINTENANCE_CONFIRMATION_DAYS=5
MAINTENANCE_DROP_PERCENT=25
MAINTENANCE_MIN_RADIATION_WH_M2=3000
